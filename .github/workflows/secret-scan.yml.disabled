# #######################################
# secret-scan.yml
# dev,release,main 브렌치 PR 생성시 동작
# 민감한 키 정보같은거 없는지 체킹
# #######################################
name: Secret Scan

on:
  pull_request:
    branches:
      - dev # feature -> dev
      - release # dev -> release
      - main # release -> main

permissions:
  contents: read

jobs:
  gitleaks:
    name: Detect leaked secrets
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Scan secrets with Gitleaks
        uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
