<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.exam.admin.mapper.CategoryMapper">

    <!--
         이름            :  findActive
         기능            :  미사용(N) 제외 카테고리 목록 — 홈 화면 필터/공연 등록 폼 드롭다운용 (CategoryServiceImpl.getActiveCategories)
         resultType     :  CategoryDTO
    -->
    <select id="findActive" resultType="CategoryDTO">
        SELECT category_id AS categoryId,
               category_nm AS categoryNm,
               sort_order  AS sortOrder,
               use_yn      AS useYn
        FROM CATEGORIES
        WHERE use_yn = 'Y'
        ORDER BY sort_order, category_id
    </select>

    <!--
         이름            :  findAll
         기능            :  관리자 화면의 전체 카테고리 목록(사용여부 무관) — CategoryServiceImpl.getAllCategories
         resultType     :  CategoryDTO
    -->
    <select id="findAll" resultType="CategoryDTO">
        SELECT category_id AS categoryId,
               category_nm AS categoryNm,
               sort_order  AS sortOrder,
               use_yn      AS useYn,
               ins_id      AS insId,
               ins_de      AS insDe,
               upt_id      AS uptId,
               upt_de      AS uptDe
        FROM CATEGORIES
        ORDER BY sort_order, category_id
    </select>

    <!--
         이름            :  existsByName
         기능            :  카테고리명 중복 체크 — CategoryServiceImpl.createCategory에서 등록 전 검사
         resultType     :  boolean
    -->
    <select id="existsByName" resultType="boolean">
        SELECT COUNT(*) > 0 FROM CATEGORIES WHERE category_nm = #{categoryNm}
    </select>

    <!--
         이름            :  existsByNameExcludingId
         기능            :  수정 시 자기 자신은 제외하고 카테고리명 중복 체크 — CategoryServiceImpl.updateCategory
         resultType     :  boolean
    -->
    <select id="existsByNameExcludingId" resultType="boolean">
        SELECT COUNT(*) > 0 FROM CATEGORIES WHERE category_nm = #{categoryNm} AND category_id != #{categoryId}
    </select>

    <!--
         이름            :  save
         기능            :  신규 카테고리 저장 — sortOrder 미지정 시 현재 최대값 + 1로 자동 배정(맨 뒤에 추가)
         parameterType  :  CategoryDTO
    -->
    <!-- sortOrder 미지정 시 0으로 고정하면 등록할 때마다 여러 카테고리가 같은 순서(0)로 겹쳐서
         화면에서 순서가 뒤죽박죽으로 보임 → 현재 가장 큰 sort_order + 1로 자동 배정(맨 뒤로 추가).
         MySQL은 INSERT 대상 테이블을 서브쿼리 FROM에 직접 쓰지 못하게 막아서(파생 테이블 트릭 필요)
         한 번 더 SELECT ... FROM (...) AS t 로 감싸야 함 -->
    <insert id="save" parameterType="CategoryDTO" useGeneratedKeys="true" keyProperty="categoryId">
        INSERT INTO CATEGORIES (category_nm, sort_order, use_yn, ins_id, ins_ip)
        VALUES (
            #{categoryNm},
            COALESCE(#{sortOrder}, (SELECT next_order FROM (SELECT COALESCE(MAX(sort_order), 0) + 1 AS next_order FROM CATEGORIES) AS t)),
            COALESCE(#{useYn}, 'Y'),
            #{insId}, #{insIp}
        )
    </insert>

    <!--
         이름            :  updateCategory
         기능            :  카테고리 수정 — CategoryServiceImpl에서 이름 중복/연결 공연 여부 검사 후 호출
         parameterType  :  CategoryDTO
    -->
    <update id="updateCategory" parameterType="CategoryDTO">
        UPDATE CATEGORIES
        <set>
            <if test="categoryNm != null">category_nm = #{categoryNm},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="useYn != null">use_yn = #{useYn},</if>
            upt_id = #{uptId},
            upt_ip = #{uptIp},
        </set>
        WHERE category_id = #{categoryId}
    </update>

    <!--
         이름            :  hasLinkedPerformances
         기능            :  이 카테고리로 등록된 공연이 있는지 확인 — 있으면 미사용 전환/삭제 모두 막음(CategoryServiceImpl)
         resultType     :  boolean
    -->
    <select id="hasLinkedPerformances" resultType="boolean">
        SELECT COUNT(*) > 0 FROM PERFORMANCES WHERE category_id = #{categoryId}
    </select>

    <!--
         이름            :  deleteCategory
         기능            :  카테고리 삭제 — hasLinkedPerformances로 연결 공연 없음을 미리 확인한 뒤에만 호출됨
    -->
    <delete id="deleteCategory">
        DELETE FROM CATEGORIES WHERE category_id = #{categoryId}
    </delete>

</mapper>
