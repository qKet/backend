<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.exam.admin.mapper.ProgramMapper">

    <!--
         이름            :  findAll
         기능            :  프로그램(메뉴에 연결되는 화면/API 단위) 목록 조회 — ProgramServiceImpl.getPrograms
         resultType     :  ProgramDTO
    -->
    <select id="findAll" resultType="ProgramDTO">
        SELECT program_id     AS programId,
               program_nm     AS programNm,
               url_path       AS urlPath,
               program_type   AS programType,
               use_yn         AS useYn
        FROM PROGRAMS
        ORDER BY program_id
    </select>

    <!--
         이름            :  save
         기능            :  신규 프로그램 저장 — ProgramServiceImpl.createProgram
         parameterType  :  ProgramDTO
    -->
    <insert id="save" parameterType="ProgramDTO" useGeneratedKeys="true" keyProperty="programId">
        INSERT INTO PROGRAMS (program_nm, url_path, program_type, use_yn, ins_id, ins_ip)
        VALUES (#{programNm}, #{urlPath}, #{programType}, COALESCE(#{useYn}, 'Y'), #{insId}, #{insIp})
    </insert>

    <!--
         이름            :  updateProgram
         기능            :  프로그램 수정 — ProgramServiceImpl.updateProgram
         parameterType  :  ProgramDTO
    -->
    <update id="updateProgram" parameterType="ProgramDTO">
        UPDATE PROGRAMS
        <set>
            <if test="programNm != null">program_nm = #{programNm},</if>
            <if test="urlPath != null">url_path = #{urlPath},</if>
            <if test="programType != null">program_type = #{programType},</if>
            <if test="useYn != null">use_yn = #{useYn},</if>
            upt_id = #{uptId},
            upt_ip = #{uptIp},
        </set>
        WHERE program_id = #{programId}
    </update>

    <!--
         이름            :  deleteProgram
         기능            :  프로그램 삭제 — ProgramServiceImpl.deleteProgram, deleteRoleProgramsByProgramId로 연결된 권한 매핑 먼저 지운 뒤 호출됨
         parameterType  :  long
    -->
    <delete id="deleteProgram" parameterType="long">
        DELETE FROM PROGRAMS WHERE program_id = #{programId}
    </delete>

    <!--
         이름            :  findAllRolePrograms
         기능            :  역할별 프로그램 접근 권한 매핑 전체 조회 — 권한 그리드 화면용(ProgramServiceImpl.getRolePrograms)
         resultType     :  RoleProgramDTO
    -->
    <select id="findAllRolePrograms" resultType="RoleProgramDTO">
        SELECT role_id AS roleId, program_id AS programId
        FROM ROLE_PROGRAMS
        ORDER BY program_id, role_id
    </select>

    <!--
         이름            :  deleteRoleProgramsByProgramId
         기능            :  특정 프로그램의 역할 매핑 전부 삭제 — deleteProgram에서 FK 정리용으로 먼저 호출
         parameterType  :  long
    -->
    <delete id="deleteRoleProgramsByProgramId" parameterType="long">
        DELETE FROM ROLE_PROGRAMS WHERE program_id = #{programId}
    </delete>

    <!--
         이름            :  deleteAllRolePrograms
         기능            :  역할-프로그램 매핑 전체 삭제 — ProgramServiceImpl.updateRolePrograms에서 그리드 저장 시 통째로 교체하기 위한 초기화(체크 상태 = 전체 최종 상태 전제)
    -->
    <delete id="deleteAllRolePrograms">
        DELETE FROM ROLE_PROGRAMS
    </delete>

    <!--
         이름            :  saveRoleProgram
         기능            :  역할-프로그램 매핑 저장 — updateRolePrograms에서 deleteAllRolePrograms 후 그리드에 체크된 항목만 재삽입
         parameterType  :  RoleProgramDTO
    -->
    <insert id="saveRoleProgram" parameterType="RoleProgramDTO">
        INSERT INTO ROLE_PROGRAMS (role_id, program_id, ins_id, ins_ip)
        VALUES (#{roleId}, #{programId}, #{insId}, #{insIp})
    </insert>

</mapper>
