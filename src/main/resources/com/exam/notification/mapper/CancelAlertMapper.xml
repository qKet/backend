<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.exam.notification.mapper.CancelAlertMapper">

    <!--
         이름            :  findUseYn
         기능            :  로그인 사용자의 해당 회차 구독 상태 조회 — NotificationServiceImpl.isSubscribed, 좌석 페이지 토글 버튼 초기 상태용. 구독 이력 없으면 null
         resultType     :  String
         parameterType  :  String userId, Long roundId
    -->
    <select id="findUseYn" resultType="String">
        SELECT use_yn
        FROM CANCEL_ALERTS
        WHERE user_id = #{userId}
          AND round_id = #{roundId}
    </select>

    <!--
         이름            :  upsert
         기능            :  구독/구독해지 토글 — NotificationServiceImpl.subscribe/unsubscribe. (user_id, round_id) 유니크라
                            같은 회차를 여러 번 눌러도 행이 늘어나지 않고 use_yn만 바뀜
         parameterType  :  CancelAlertDTO
    -->
    <insert id="upsert" parameterType="CancelAlertDTO">
        INSERT INTO CANCEL_ALERTS (user_id, round_id, use_yn, ins_id, ins_ip)
        VALUES (#{userId}, #{roundId}, #{useYn}, #{insId}, #{insIp})
        ON DUPLICATE KEY UPDATE
            use_yn = #{useYn},
            upt_id = #{insId},
            upt_ip = #{insIp}
    </insert>

    <!--
         이름            :  findActiveSubscribersByRoundId
         기능            :  해당 회차를 구독 중(use_yn='Y')인 수신자 이메일 + 공연/회차 정보 조회 — ReservationServiceImpl.cancel()에서
                            취소 발생 시 NotificationServiceImpl.publishCancelAlerts가 SQS 메시지 payload를 만드는 데 씀
         resultType     :  CancelAlertRecipientDTO
         parameterType  :  Long
    -->
    <select id="findActiveSubscribersByRoundId" resultType="CancelAlertRecipientDTO">
        SELECT u.user_email  AS userEmail,
               p.p_title     AS pTitle,
               v.venue_name  AS venueName,
               pr.round_time AS roundTime
        FROM CANCEL_ALERTS ca
        JOIN USERS u ON ca.user_id = u.user_id
        JOIN PERFORMANCE_ROUND pr ON ca.round_id = pr.round_id
        JOIN PERFORMANCES p ON pr.performance_id = p.performance_id
        JOIN VENUE v ON p.venue_id = v.venue_id
        WHERE ca.round_id = #{roundId}
          AND ca.use_yn = 'Y'
    </select>

    <!--
         이름            :  deleteByRoundId
         기능            :  회차 삭제 캐스케이드 — AdminPerformanceController.deleteRound. round_id FK라 회차 삭제 전에 먼저 지워야 함
         parameterType  :  Long
    -->
    <delete id="deleteByRoundId">
        DELETE FROM CANCEL_ALERTS
        WHERE round_id = #{roundId}
    </delete>

    <!--
         이름            :  deleteByPerformanceId
         기능            :  공연 삭제 캐스케이드 — AdminPerformanceController.deletePerformance. CANCEL_ALERTS는 round_id만 갖고 있어서
                            PERFORMANCE_ROUND를 거쳐 해당 공연 소속 회차를 찾아 지움 (회차 삭제 전에 먼저 지워야 FK 위반 안 남)
         parameterType  :  Long
    -->
    <delete id="deleteByPerformanceId">
        DELETE ca FROM CANCEL_ALERTS ca
        JOIN PERFORMANCE_ROUND pr ON ca.round_id = pr.round_id
        WHERE pr.performance_id = #{performanceId}
    </delete>

</mapper>
